# Zemest backend — environment configuration
# Copy to .env and fill in the credentials for FULLY REAL operation.

# ------------------------------------------------------------------
# REQUIRED for the AI agent (pick ONE — both have free tiers)
# ------------------------------------------------------------------
# OpenRouter (default: free meta-llama/llama-4-maverick:free)
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Concurrent-user scale-out (optional): comma-separated keys, round-robin
# with 60s cooldown on 429s, plus an in-flight cap so spikes queue.
# OPENROUTER_API_KEYS=key-one,key-two
# LLM_MAX_CONCURRENCY=8

# Encrypted data vault (optional): generate once, BACK IT UP
#   python -c "import secrets; print(secrets.token_hex(32))"
# VAULT_MASTER_KEY=
# VAULT_DIR=data/vault
# OR Google Gemini (free: 15 RPM, 1M tokens/day)
# GEMINI_API_KEY=
# LLM_PROVIDER=auto   # auto | openrouter | gemini | ollama

# ------------------------------------------------------------------
# REQUIRED for channel webhooks (Meta for Developers → your app)
# https://developers.facebook.com/apps
# ------------------------------------------------------------------
FB_APP_ID=
FB_APP_SECRET=
# Any random string — the SAME value goes into the Meta dashboard
# webhook "Verify token" field.
FB_VERIFY_TOKEN=zemest-verify-token

# ------------------------------------------------------------------
# Auth / database
# ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Local dev (SQLite) — the daemon sets this automatically
# DATABASE_URL=sqlite+aiosqlite:///./zemest_local.db

# Optional infrastructure (falls back gracefully when absent)
# REDIS_URL=redis://localhost:6379/0        # rate limiter + Celery
# SCHEDULER_INLINE_WORKER=true              # false when Celery beat deployed

# ------------------------------------------------------------------
# PRODUCTION — use deploy/docker-compose.prod.yml (the canonical stack).
# Copy deploy/.env.example → deploy/.env there; it carries every key.
# ------------------------------------------------------------------
APP_ENV=production
# Public origin — REQUIRED for Paymob intentions; webhook URLs are built
# from this, never from the request Host header.
PUBLIC_BASE_URL=https://your-domain.com
# Fernet key for encrypting channel tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Multi-service docker deployment ONLY (the compose file sets these):
#   SCHEDULER_INLINE_WORKER=false on api replicas, true on the scheduler svc
#   HUEY_INLINE_CONSUMER=false everywhere except the worker svc
#   HUEY_EXTERNAL_WORKER=true on api (enqueue, don't run inline)
#   HUEY_SQLITE_PATH=/huey/huey_queue.db (shared volume)
# Postgres (used by the prod compose — fill strong values)
POSTGRES_USER=zemest
POSTGRES_PASSWORD=
POSTGRES_DB=zemest
# The domain Caddy terminates TLS for
ZEMEST_DOMAIN=your-domain.com
