# Zemest backend — environment configuration
# Copy to .env and fill in the credentials for FULLY REAL operation.

# ------------------------------------------------------------------
# REQUIRED for the AI agent (pick ONE — both have free tiers)
# ------------------------------------------------------------------
# OpenRouter (default: free meta-llama/llama-4-maverick:free)
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OR Google Gemini (free: 15 RPM, 1M tokens/day)
# GEMINI_API_KEY=
# LLM_PROVIDER=auto   # auto | openrouter | gemini | ollama

# ------------------------------------------------------------------
# REQUIRED for channel webhooks (Meta for Developers → your app)
# https://developers.facebook.com/apps
# ------------------------------------------------------------------
FB_APP_ID=
FB_APP_SECRET=
# Any random string — the SAME value goes into the Meta dashboard
# webhook "Verify token" field.
FB_VERIFY_TOKEN=zemest-verify-token

# ------------------------------------------------------------------
# Billing — payment rails (payoneer PRIMARY / paymob BACKUP / usdc_solana crypto)
# Every rail is optional: the checkout buttons only show configured rails.
# ------------------------------------------------------------------
# Payoneer Checkout (primary card rail, USD)
PAYONEER_API_TOKEN=
PAYONEER_PARTNER_ID=
PAYONEER_PROGRAM_ID=
# Webhook HMAC (fail-closed when unset). Portal webhook URL:
#   https://your-domain.com/api/payments/webhook/payoneer
PAYONEER_WEBHOOK_SECRET=
# Defaults: sha256 + X-Payoneer-Signature — override only if your portal differs.
# PAYONEER_WEBHOOK_ALGO=sha256
# PAYONEER_SIG_HEADER=X-Payoneer-Signature

# Paymob (backup rail, Egypt EGP — reuse of the order-payment credentials)
# Billing webhook: https://your-domain.com/api/payments/webhook/paymob
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_IDS=
PAYMOB_WEBHOOK_HMAC_SECRET=

# USDC over Solana (crypto rail — direct JSON-RPC, no sidecar, no custody)
# NEVER put a private key here: the app is read-only against the chain.
USDC_TREASURY_WALLET=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_API_TOKEN=
# USDC_MINT_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# USDC_CONFIRMATIONS_REQUIRED=32
# USDC_AMOUNT_TOLERANCE=100

# Shared billing behavior
BILLING_ENABLED=true
# Pin the public origin handed to providers for callbacks — set it in
# production so a Host-header spoof cannot hijack notification URLs.
BILLING_WEBHOOK_PUBLIC_URL=
BILLING_USD_TO_EGP_RATE=48.0
BILLING_DUNNING_MAX_ATTEMPTS=4

# Treasury withdrawals (admin, 2-approval workflow)
TREASURY_MIN_RESERVE_USDC=10.0
TREASURY_BANK_LABEL=Operator bank account (configured offline)

# ------------------------------------------------------------------
# Auth / database
# ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Local dev (SQLite) — the daemon sets this automatically
# DATABASE_URL=sqlite+aiosqlite:///./zemest_local.db

# Optional infrastructure (falls back gracefully when absent)
# REDIS_URL=redis://localhost:6379/0        # rate limiter
# SCHEDULER_INLINE_WORKER=true              # false when an external worker owns the jobs
