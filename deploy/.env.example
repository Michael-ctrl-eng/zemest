# ==================================================================
# Zemest — PRODUCTION environment (deploy/.env.example)
# Copy to deploy/.env (or repos/zemest/.env) on the server and fill in.
# NEVER commit the filled-in file. Secrets stay env-only — the app has
# no compiled-in credentials.
# ==================================================================

# ------------------------------------------------------------------
# Core
# ------------------------------------------------------------------
APP_ENV=production
APP_NAME=Zemest
# REQUIRED — refuse to boot in production without a real secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Postgres (docker-compose provisioned)
POSTGRES_USER=zemest
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=zemest
# The compose file derives DATABASE_URL / DATABASE_URL_SYNC from these.

# Rate limiting backend (falls back to in-memory when absent)
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------
# LLM brain (required — free tier available)
# ------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-4-maverick:free
# GEMINI_API_KEY=
# LLM_PROVIDER=auto

# ------------------------------------------------------------------
# Channels (Meta)
# ------------------------------------------------------------------
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=change-me-random
# WhatsApp Cloud API + Page tokens are configured per-tenant in the
# dashboard (Settings → Connect), not in env.

# ------------------------------------------------------------------
# Billing — payment rails
#   payoneer    = PRIMARY card rail (USD)
#   paymob      = BACKUP rail (Egypt EGP)
#   usdc_solana = crypto rail (direct Solana JSON-RPC — no sidecar,
#                 no custody, the app NEVER signs transactions)
# ------------------------------------------------------------------
BILLING_ENABLED=true
# Pin the public origin for ALL provider callbacks (anti Host-header
# hijack). MUST be set in production.
BILLING_WEBHOOK_PUBLIC_URL=https://your-domain.com
BILLING_USD_TO_EGP_RATE=48.0
BILLING_DUNNING_MAX_ATTEMPTS=4

# Payoneer Checkout (primary) — webhook:
#   https://your-domain.com/api/payments/webhook/payoneer
PAYONEER_API_TOKEN=
PAYONEER_PARTNER_ID=
PAYONEER_PROGRAM_ID=
PAYONEER_WEBHOOK_SECRET=
# Defaults (override only if the portal differs):
# PAYONEER_WEBHOOK_ALGO=sha256
# PAYONEER_SIG_HEADER=X-Payoneer-Signature

# Paymob (backup) — webhook:
#   https://your-domain.com/api/payments/webhook/paymob
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_IDS=
PAYMOB_WEBHOOK_HMAC_SECRET=
PAYMOB_BASE_URL=https://egypt.paymob.com

# USDC-Solana (crypto) — treasury wallet: a wallet YOU control.
# NEVER paste a private key or seed phrase anywhere in this file.
USDC_TREASURY_WALLET=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_API_TOKEN=
USDC_MINT_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
USDC_CONFIRMATIONS_REQUIRED=32
USDC_SCAN_LIMIT=40
USDC_AMOUNT_TOLERANCE=100

# Treasury withdrawal policy (admin 2-approval workflow)
TREASURY_MIN_RESERVE_USDC=10.0
TREASURY_BANK_LABEL=Operator bank account (configured offline)

# ------------------------------------------------------------------
# Optional services
# ------------------------------------------------------------------
# Postiz (social scheduler sidecar)
POSTIZ_URL=http://localhost:4007
POSTIZ_EMAIL=
POSTIZ_PASSWORD=

# Email notifications (billing success / order alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=noreply@your-domain.com

# Scheduler / worker topology: the `app` container runs the inline
# APScheduler (hourly billing cycle, publish, trainer) when these are
# true; the `worker` container runs the huey consumer.
SCHEDULER_INLINE_WORKER=true
SILENT_TRAINER_INLINE_WORKER=true
HUEY_INLINE_CONSUMER=false
HUEY_SQLITE_PATH=huey_queue.db
