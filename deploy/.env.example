# ============================================================================
# Zemest PRODUCTION environment — the canonical checklist.
# Copy to deploy/.env and fill every REQUIRED slot.
# Companion guide: ZEMEST_API_KEYS_GUIDE.md (repo root) — step by step.
# ============================================================================

# ---------------------------------------------------------------------------
# 1) Core (REQUIRED)
# ---------------------------------------------------------------------------
# Your public domain (Caddy terminates TLS for it)
ZEMEST_DOMAIN=your-domain.com
PUBLIC_BASE_URL=https://your-domain.com

# Postgres (compose wires app + pgbouncer + backups from these)
POSTGRES_USER=zemest
POSTGRES_PASSWORD=            # generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_DB=zemest

# Auth secrets (REQUIRED)
# generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Fernet key for channel-token + analytics-blob encryption at rest
# generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Any random string — SAME value goes into the Meta webhook "Verify token"
FB_VERIFY_TOKEN=zemest-verify-token

# First admin login (bootstrap_superadmin.py)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# 2) AI providers (REQUIRED for live replies; free tiers exist)
# ---------------------------------------------------------------------------
# Primary chat LLM — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-4-maverick:free
# Vision (product images) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# (Voice runs locally via faster-whisper — no key, no cost.)

# ---------------------------------------------------------------------------
# 3) Meta channels (REQUIRED to serve FB/IG/WA customers)
#        https://developers.facebook.com → your app → Settings → Basic
# ---------------------------------------------------------------------------
FB_APP_ID=
FB_APP_SECRET=
# OAuth redirect origin (frontend)
FB_OAUTH_REDIRECT_ORIGIN=https://your-domain.com

# ---------------------------------------------------------------------------
# 4) Payments (OPTIONAL — COD works without any of this)
#        https://egypt.paymob.com → Developers
# ---------------------------------------------------------------------------
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_IDS=
PAYMOB_WEBHOOK_HMAC_SECRET=

# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 4b) Billing rails — payoneer (PRIMARY) / paymob (BACKUP) / usdc_solana
#     (crypto, direct Solana JSON-RPC — no sidecar, no custody, the app
#     NEVER signs transactions)
# ---------------------------------------------------------------------------
BILLING_ENABLED=true
# Pin the public origin for ALL provider callbacks (anti Host-header
# hijack). MUST be set in production.
BILLING_WEBHOOK_PUBLIC_URL=https://your-domain.com
BILLING_USD_TO_EGP_RATE=48.0
BILLING_DUNNING_MAX_ATTEMPTS=4

# Payoneer Checkout (primary card rail) — webhook:
#   https://your-domain.com/api/payments/webhook/payoneer
PAYONEER_API_TOKEN=
PAYONEER_PARTNER_ID=
PAYONEER_PROGRAM_ID=
PAYONEER_WEBHOOK_SECRET=
# Defaults (override only if the portal differs):
# PAYONEER_WEBHOOK_ALGO=sha256
# PAYONEER_SIG_HEADER=X-Payoneer-Signature

# USDC-Solana (crypto) — treasury wallet: a wallet YOU control.
# NEVER paste a private key or seed phrase anywhere in this file.
USDC_TREASURY_WALLET=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_API_TOKEN=
USDC_MINT_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
USDC_CONFIRMATIONS_REQUIRED=32
USDC_SCAN_LIMIT=40
USDC_AMOUNT_TOLERANCE=100

# Treasury withdrawal policy (admin 2-approval workflow)
TREASURY_MIN_RESERVE_USDC=10.0
TREASURY_BANK_LABEL=Operator bank account (configured offline)

# 5) Email notifications (OPTIONAL)
#    Brevo 300/day or Resend 100/day free tiers, or a Gmail app password
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=noreply@your-domain.com

# ---------------------------------------------------------------------------
# 6) Telegram admin alerts (OPTIONAL — reports + abuse pings to your phone)
#    1) Telegram → @BotFather → /newbot → copy the token
#    2) Send your bot any message (opens the chat)
#    3) Open https://api.telegram.org/bot<TOKEN>/getUpdates
#       → copy result[0].message.chat.id
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ---------------------------------------------------------------------------
# 6b) Encrypted data vault (OPTIONAL — chat/profile archives in the admin
#     panel). Generate ONCE and back it up; losing it loses the vault:
#       python -c "import secrets; print(secrets.token_hex(32))"
#     Without it the vault panel shows "disabled"; nothing else changes.
# ---------------------------------------------------------------------------
VAULT_MASTER_KEY=
# VAULT_DIR=data/vault

# ---------------------------------------------------------------------------
# 7) Postiz scheduling sidecar (OPTIONAL self-hosted)
# ---------------------------------------------------------------------------
POSTIZ_MAIN_URL=http://localhost:4007
POSTIZ_EMAIL=
POSTIZ_PASSWORD=
POSTIZ_JWT_SECRET=            # generate like JWT_SECRET_KEY
POSTIZ_POSTGRES_PASSWORD=     # generate like POSTGRES_PASSWORD

# ---------------------------------------------------------------------------
# 8) Front build-time (public, NON-secret)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_FB_APP_ID=

# ---------------------------------------------------------------------------
# NOT NEEDED / intentionally absent:
# - Analytics keys: first-party tracking (zstd+Fernet at rest), no vendor.
# - Redis: rate limiter falls back in-memory; add REDIS_URL only at scale.
# - GitHub Actions secrets: CI uses the built-in GITHUB_TOKEN.
# - Any AI key on the CLIENT: all AI calls run server-side in FastAPI; the
#   browser only talks to your own domain (Next.js BFF → httpOnly cookie).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 9) Scheduler / worker topology
#     The `app` container runs the inline APScheduler (hourly billing
#     cycle, publish, trainer) when these are true; the `worker`
#     container runs the huey consumer.
# ---------------------------------------------------------------------------
SCHEDULER_INLINE_WORKER=true
SILENT_TRAINER_INLINE_WORKER=true
HUEY_INLINE_CONSUMER=false
HUEY_SQLITE_PATH=huey_queue.db
